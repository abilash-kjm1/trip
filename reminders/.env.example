# Copy these into Vercel -> Settings -> Environment Variables.
# Never commit real values. Nothing here is ever read by the browser.

# Any long random string. Vercel Cron sends it as a bearer token.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# The whole service-account JSON on one line.
# Firebase Console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}

FIREBASE_DATABASE_URL=https://trip-expense-35c6d-default-rtdb.firebaseio.com

# resend.com -> API Keys
RESEND_API_KEY=

# Optional. Until a domain is verified with Resend, onboarding@resend.dev
# can only deliver to your own address.
REMINDER_FROM=Settle <onboarding@resend.dev>

# Optional. Where the button in the email points.
APP_URL=https://abilash-kjm1.github.io/trip/
