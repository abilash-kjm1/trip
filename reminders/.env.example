# Copy these into Vercel -> Settings -> Environment Variables.
# Never commit real values. Nothing here is ever read by the browser.

# Any long random string. Vercel Cron sends it as a bearer token.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# The whole service-account JSON on one line.
# Firebase Console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}

FIREBASE_DATABASE_URL=https://trip-expense-35c6d-default-rtdb.firebaseio.com

# ---- sending: pick ONE ----
#
# Brevo verifies a single SENDER ADDRESS, so it needs no domain and can mail
# anybody from the start. This is the one to use for a group of friends.
# brevo.com -> SMTP & API -> API Keys
BREVO_API_KEY=

# Resend only delivers to the account owner until a DOMAIN is verified.
# Better once you own a domain; useless for a group before that.
# resend.com -> API Keys
RESEND_API_KEY=

# Optional. Forces one when both keys are present: brevo | resend
EMAIL_PROVIDER=

# Who the email comes from. With Brevo this address must be verified under
# Senders. With Resend it must be on a verified domain.
REMINDER_FROM=Settle <abilashkjm01@gmail.com>

# Optional. Where the button in the email points.
APP_URL=https://abilash-kjm1.github.io/trip/

# Optional. The local window a reminder may be sent in, 24h clock.
# Defaults to 16-20, which covers Toronto both sides of the clock change.
SEND_HOUR_FROM=16
SEND_HOUR_TO=20
