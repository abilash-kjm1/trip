// STEP 3. Publish this AFTER the app has been open once on every device,
// and after the scheduler has had one pass (five minutes) to fill in each
// group's membership list.
//
// Being approved is no longer enough to read a group: you have to be in it.
// Membership lives at trips/{gid}/uids, because a rule cannot scan a list of
// people looking for an account. The scheduler keeps that list in step with
// the people records, so nothing has to be filled in by hand.
//
// A group's name stays readable to anyone approved, so somebody following a
// link is told what they are asking to be added to rather than nothing at all.
//
// Only the administrator can delete a group. Members can still change what is
// inside it, but a write that would leave the group without its details -
// deleting it outright, or wiping it - is refused for anyone else.
{
  "rules": {
    "trips": {
      ".read": "auth != null && (auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com')",
      "$gid": {
        ".read": "auth != null && (data.child('uids').child(auth.uid).exists() || (auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com'))",
        ".write": "auth != null && ((auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com') || (data.child('uids').child(auth.uid).exists() && newData.exists() && (newData.child('meta').exists() || !data.child('meta').exists())) || (!data.exists() && newData.child('uids').child(auth.uid).exists()))",
        "meta": {
          ".read": "auth != null && (root.child('access').child(auth.uid).child('status').val() == 'approved' || (auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com'))"
        }
      }
    },
    "access": {
      ".read": "auth != null && auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com'",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || (auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com'))",
        ".write": "auth != null && ((auth.uid == $uid && !data.exists() && newData.child('status').val() == 'pending') || (auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com'))",
        ".validate": "newData.hasChildren(['status','at']) && newData.child('status').isString()"
      }
    },
    "directory": {
      ".read": "auth != null && (root.child('access').child(auth.uid).child('status').val() == 'approved' || (auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com'))",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['name']) && newData.child('name').isString()"
      }
    },
    "config": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com'"
    },
    "users": {
      ".read": "auth != null && auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com'",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || (auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com'))",
        ".write": "auth != null && (auth.uid == $uid || (auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com'))"
      }
    },
    "mail": {
      "queue": {
        ".read": false,
        "$k": {
          ".write": "auth != null && !data.exists() && newData.child('actorUid').val() == auth.uid",
          ".validate": "newData.hasChildren(['kind','actorUid','at']) && newData.child('kind').isString() && newData.child('at').isNumber()"
        }
      }
    },
    "invites": {
      "$ekey": {
        ".read": "auth != null && auth.token.email_verified == true && $ekey == auth.token.email.toLowerCase().replace('.', ',')",
        ".write": "auth != null"
      }
    }
  }
}
