// STEP 3. Publish this AFTER the app has been open once on every device,
// and after the scheduler has had one pass (five minutes) to fill in each
// group's membership list.
//
// Being approved is no longer enough to read a group: you have to be in it.
// Membership lives at trips/{gid}/uids, because a rule cannot scan a list of
// people looking for an account. The scheduler keeps that list in step with
// the people records, so nothing has to be filled in by hand.
//
// A group's name stays readable to anyone approved, so somebody following a
// link is told what they are asking to be added to rather than nothing at all.
//
// Interac details live at directory/{uid}/pay. The person can write their own;
// the administrator can write that part - and only that part - of anyone's
// entry. Its shape is checked for both: a name and an email or phone.
// UPI details for India sit beside them at directory/{uid}/upi, under the same
// arrangement: a name and a UPI ID shaped like name@bank.
//
// A group's currency (meta/currency) can only be CAD or INR.
//
// Only the administrator can delete a group. Members can still change what is
// inside it, but a write that would leave the group without its details -
// deleting it outright, or wiping it - is refused for anyone else.
{
  "rules": {
    // Membership (people/uids), the group's own details (meta) and its
    // ledger (expenses/payments) each have their own .write rule now,
    // instead of one blanket rule at $gid covering everything underneath.
    // Realtime Database always lets an ancestor's grant cascade down and
    // win, even over a stricter rule closer to the data - which is exactly
    // why a single membership check at $gid used to let anyone in a group
    // rewrite any expense or payment with the browser's developer tools.
    // $gid's own rule is narrowed to only the two things that really are
    // whole-group operations: creating a brand new group, and the
    // administrator deleting or managing one.
    //
    // expenses/$id and payments/$id: only whoever added a line (byUid) may
    // change or remove it, or the administrator - except a record from
    // before byUid was tracked, which stays open to any member exactly as
    // before. A member renaming themselves, or merging a duplicate, moves
    // that name across every expense and payment that mentions it - so a
    // write that leaves the amount (and the mode, or who it went between)
    // untouched is allowed for anyone in the group; changing what was paid,
    // or by whom, or how it was split, is not. On a payment, the person it
    // went to may also answer whether it arrived, or the payer may ask
    // again - both write only "got"/"later", leaving every other field on
    // the record exactly as it was.
    "trips": {
      ".read": "auth != null && (auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com')",
      "$gid": {
        ".read": "auth != null && (data.child('uids').child(auth.uid).exists() || (auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com'))",
        ".write": "auth != null && ((auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com') || (!data.exists() && newData.child('uids').child(auth.uid).exists()))",
        "meta": {
          ".read": "auth != null && (root.child('access').child(auth.uid).child('status').val() == 'approved' || (auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com'))",
          ".write": "auth != null && ((auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com') || root.child('trips').child($gid).child('uids').child(auth.uid).exists() || !data.child('name').exists())",
          "currency": {
            ".validate": "newData.isString() && newData.val().matches(/^(CAD|INR)$/)"
          }
        },
        "people": {
          ".write": "auth != null && (root.child('trips').child($gid).child('uids').child(auth.uid).exists() || (auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com'))"
        },
        "uids": {
          ".write": "auth != null && (root.child('trips').child($gid).child('uids').child(auth.uid).exists() || (auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com'))"
        },
        "expenses": {
          "$id": {
            ".write": "auth != null && ((auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com') || (root.child('trips').child($gid).child('uids').child(auth.uid).exists() && ((!data.exists() && newData.exists() && newData.child('byUid').val() == auth.uid) || (data.exists() && data.child('byUid').exists() && data.child('byUid').val() == auth.uid) || (data.exists() && !data.child('byUid').exists()) || (data.exists() && newData.exists() && newData.child('amount').val() == data.child('amount').val() && newData.child('mode').val() == data.child('mode').val()))))"
          }
        },
        "payments": {
          "$id": {
            ".write": "auth != null && ((auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com') || (root.child('trips').child($gid).child('uids').child(auth.uid).exists() && ((!data.exists() && newData.exists() && newData.child('byUid').val() == auth.uid) || (data.exists() && data.child('byUid').exists() && data.child('byUid').val() == auth.uid) || (data.exists() && !data.child('byUid').exists()) || (data.exists() && newData.exists() && newData.child('amount').val() == data.child('amount').val() && newData.child('at').val() == data.child('at').val()) || (data.exists() && newData.exists() && newData.child('from').val() == data.child('from').val() && newData.child('to').val() == data.child('to').val() && newData.child('amount').val() == data.child('amount').val() && newData.child('note').val() == data.child('note').val() && newData.child('at').val() == data.child('at').val() && newData.child('by').val() == data.child('by').val() && newData.child('byUid').val() == data.child('byUid').val()))))"
          }
        }
      }
    },
    "access": {
      ".read": "auth != null && auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com'",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || (auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com'))",
        ".write": "auth != null && ((auth.uid == $uid && !data.exists() && newData.child('status').val() == 'pending') || (auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com'))",
        ".validate": "newData.hasChildren(['status','at']) && newData.child('status').isString()"
      }
    },
    "directory": {
      ".read": "auth != null && (root.child('access').child(auth.uid).child('status').val() == 'approved' || (auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com'))",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['name']) && newData.child('name').isString()",
        "pay": {
          ".write": "auth != null && auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com'",
          ".validate": "newData.hasChildren(['name','handle']) && newData.child('name').isString() && newData.child('name').val().length <= 60 && newData.child('handle').isString() && newData.child('handle').val().length <= 120"
        },
        "upi": {
          ".write": "auth != null && auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com'",
          ".validate": "newData.hasChildren(['name','vpa']) && newData.child('name').isString() && newData.child('name').val().length <= 60 && newData.child('vpa').isString() && newData.child('vpa').val().length <= 120 && newData.child('vpa').val().matches(/^[a-z0-9][a-z0-9._-]+@[a-z][a-z0-9]+$/)"
        }
      }
    },
    "presence": {
      ".read": "auth != null && (root.child('access').child(auth.uid).child('status').val() == 'approved' || (auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com'))",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['online','at']) && newData.child('online').isBoolean() && newData.child('at').isNumber()"
      }
    },
    // Realtime Database only honours a .read rule at the exact path being
    // listened to - a rule nested under $id does not apply to a listener on
    // the parent "announcements" itself, which is what a broad list needs.
    // So this is two real, separately-readable places rather than one:
    // "all" for broadcasts, everyone approved can list it directly; "inbox"
    // for a message to one person, keyed by their uid, so their own listen
    // is a listen at a path that actually grants it. "sent" is the admin's
    // own write-once log of everything sent, for the history list - reading
    // it never has to reach into every account's private inbox.
    "announcements": {
      "all": {
        ".read": "auth != null && (root.child('access').child(auth.uid).child('status').val() == 'approved' || (auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com'))",
        ".write": "auth != null && auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com'",
        "$id": {
          ".validate": "newData.hasChildren(['text','at','byUid']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 500 && newData.child('at').isNumber()",
          "ack": {
            "$uid": {
              ".write": "auth != null && auth.uid == $uid",
              ".validate": "newData.hasChildren(['at']) && newData.child('at').isNumber()"
            }
          }
        }
      },
      "inbox": {
        "$to": {
          ".read": "auth != null && (auth.uid == $to || (auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com'))",
          ".write": "auth != null && auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com'",
          "$id": {
            ".validate": "newData.hasChildren(['text','at','byUid']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 500 && newData.child('at').isNumber()",
            "ack": {
              "$uid": {
                ".write": "auth != null && auth.uid == $uid && auth.uid == $to",
                ".validate": "newData.hasChildren(['at']) && newData.child('at').isNumber()"
              }
            }
          }
        }
      },
      "sent": {
        ".read": "auth != null && auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com'",
        ".write": "auth != null && auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com'",
        "$id": {
          ".validate": "newData.hasChildren(['text','at','byUid','to']) && newData.child('text').isString() && newData.child('at').isNumber() && newData.child('to').isString()"
        }
      }
    },
    "config": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com'"
    },
    "users": {
      ".read": "auth != null && auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com'",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || (auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com'))",
        ".write": "auth != null && (auth.uid == $uid || (auth.token.email_verified == true && auth.token.email.toLowerCase() == 'abilashkjm01@gmail.com'))"
      }
    },
    "mail": {
      "queue": {
        ".read": false,
        "$k": {
          ".write": "auth != null && !data.exists() && newData.child('actorUid').val() == auth.uid",
          ".validate": "newData.hasChildren(['kind','actorUid','at']) && newData.child('kind').isString() && newData.child('at').isNumber()"
        }
      }
    },
    "invites": {
      "$ekey": {
        ".read": "auth != null && auth.token.email_verified == true && $ekey == auth.token.email.toLowerCase().replace('.', ',')",
        ".write": "auth != null"
      }
    }
  }
}
